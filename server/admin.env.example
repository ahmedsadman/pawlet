# pawlet-admin configuration. Copy to admin.env (gitignored) and fill in.
# The admin service never needs pawletd's OpenRouter key, JWT secret or
# service account — keep those out of this file.

# Required: argon2id hash of the dashboard password.
# Generate with: go run ./cmd/pawlet-admin hash-password   (type the password, press Enter)
ADMIN_PASSWORD_HASH=

# Required: secret that signs the session cookie, at least 32 bytes.
# Generate with: openssl rand -base64 48
# Rotating it signs every browser out.
ADMIN_SESSION_SECRET=

# Listen address (default :8080 inside the container).
# ADMIN_ADDR=:8092

# SQLite database written by pawletd (default /data/pawlet.db).
# DATABASE_PATH=/data/pawlet.db

# Proxy network whose X-Forwarded-For is trusted (default 172.16.0.0/12).
# TRUSTED_PROXY_CIDR=172.16.0.0/12
