# Required: OpenRouter API key for LLM classification calls
OPENROUTER_API_KEY=

# Required: JWT secret (minimum 32 bytes). Generate with: openssl rand -base64 48
JWT_SECRET=

# Required: Path to Google service account JSON for Play Integrity API
GOOGLE_SERVICE_ACCOUNT_JSON=/run/secrets/sa.json

# Required: Comma-separated SHA-256 digests of the Play **app-signing** certificates.
# CRITICAL: Use the app-signing digest from Play Console, NOT the upload certificate.
# Using the upload digest will reject all genuine installs.
CERT_SHA256_DIGESTS=

# Optional: Comma-separated OpenRouter model IDs to try in order.
# If unset, uses the app's current fallback list (nvidia/nemotron, qwen3.8, nex-n2.5).
# MODELS=nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3.8-27b:free

# Android package name (default: com.pastabyte.pawlet)
PACKAGE_NAME=com.pastabyte.pawlet

# Rate limits
DAILY_PER_INSTALL=200
BURST_PER_MIN=20
GLOBAL_DAILY_CAP=20000
CHALLENGE_PER_IP_HOUR=60

# Docker network CIDR for trusted proxies (default: 172.16.0.0/12)
TRUSTED_PROXY_CIDR=172.16.0.0/12

# Environment: development or production (default: development)
ENV=production

# Development bypass secret. MUST NOT be set when ENV=production.
# DEV_SHARED_SECRET=

# Server bind address (default: :8080)
ADDR=:8080

# SQLite database path (default: /data/pawlet.db)
DATABASE_PATH=/data/pawlet.db
